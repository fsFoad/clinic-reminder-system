DATABASE_URL=postgres://clinic:YOUR_PASSWORD@localhost:5432/clinic_reminder
DATABASE_URL_MIGRATE=postgres://clinic:YOUR_PASSWORD@localhost:5432/clinic_reminder
TZ=Asia/Tehran
PORT=3000
FALLBACK_HOURS=4
CORS_ORIGIN=http://localhost:4200
# Auto reminder poller (hours-before from clinic settings). 0 = off.
REMINDER_CRON_ENABLED=true
REMINDER_CRON_MS=60000
# Identity for settings when Authorization is missing (curl). Front uses Bearer mock-{id}.
DEFAULT_SETTINGS_USER_ID=1
# One-time import of data/clinic-settings.json into this user (front admin = 2).
LEGACY_SETTINGS_USER_ID=2

# --- SMS.ir (real SMS channel) ---
# Promotional/demo line only — production needs a service line (9000 / 998).
# Blacklisted recipients will not receive promotional SMS; messageIds may be 0.
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=30002108030582
SMSIR_BASE_URL=https://api.sms.ir/v1
# Header used by the client: x-api-key
# Inbound poller (GET /receive/latest) — no webhook. Default every 5 minutes.
SMSIR_POLL_ENABLED=true
SMSIR_POLL_MS=300000
# Also poll GET /send/pack/{packId} for delivery_status updates
SMSIR_DELIVERY_POLL_ENABLED=true
# When true, sendBulk/receive do not hit the network (fake pack/message ids)
SMSIR_DRY_RUN=false
# Optional live smoke: yarn smsir:smoke only sends if this is set
# SMSIR_SMOKE_MOBILE=0912xxxxxxx
